{
  "version": 2,
  "framework": null,
  "routes": [
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/style.css", "dest": "/frontend/style.css" },
    { "src": "/app.js", "dest": "/frontend/app.js" },
    { "src": "/frontend/(.*)", "dest": "/frontend/$1" },
    { "src": "/processed_data/(.*)", "dest": "/processed_data/$1" },
    { "src": "/player_data/(.*)", "dest": "/player_data/$1" },
    { "handle": "filesystem" }
  ]
}
